// ---------------------------------------------------------------------------
// Nextflow configuration for the lcasanovo PXD pipeline
// ---------------------------------------------------------------------------

manifest {
    name        = 'lcasanovo-pipeline'
    description = 'PXD → lcasanovo de novo sequencing pipeline'
    version     = '0.1.0'
    nextflowVersion = '>=23.04'
}

// Default resource limits (override in profiles below)
process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: 'FETCH_FILE_LIST' {
        cpus   = 1
        memory = '1 GB'
        time   = '10 min'
    }
    withName: 'DOWNLOAD_FILE' {
        cpus   = 2
        memory = '4 GB'
        time   = '6 h'
    }
    withName: 'CONVERT_RAW' {
        cpus      = 4
        memory    = '16 GB'
        time      = '4 h'
        container = 'quay.io/biocontainers/thermorawfileparser:1.4.5--ha8f3691_0'
    }
    withName: 'CASANOVO_SEQUENCE' {
        cpus   = 4
        memory = '32 GB'
        time   = '24 h'
        // Request GPU if available; Nextflow ignores this on CPU-only systems
        accelerator = 1
    }
    withName: 'MERGE_RESULTS' {
        cpus   = 1
        memory = '4 GB'
        time   = '1 h'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    // Run everything locally (default)
    local {
        process.executor       = 'local'
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.pullTimeout = '60 min'
    }

    // Local with Singularity/Apptainer (default for containers)
    singularity {
        process.executor       = 'local'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Local with Docker / Podman
    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '--gpus all'
    }

    // SLURM cluster with Singularity (adjust queue names to match your HPC)
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'gpu'
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withName: 'CASANOVO_SEQUENCE' {
                clusterOptions = '--gres=gpu:1'
            }
            withName: 'CONVERT_RAW' {
                queue = 'short'
            }
            withName: 'DOWNLOAD_FILE' {
                queue = 'short'
            }
        }
    }

    // Conda-only (no containers; casanovo must be installed in the active env)
    conda_env {
        process.executor = 'local'
        conda.enabled    = true
        process {
            withName: 'CASANOVO_SEQUENCE' {
                conda = 'casanovo'   // name of existing conda env, or path to env.yml
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.png"
    overwrite = true
}
